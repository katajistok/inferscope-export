{
  "title": "Inferscope — Token Consumption",
  "uid": "inferscope-tokens",
  "version": 1,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "tags": ["inferscope", "tokens", "kubernetes"],
  "description": "Token consumption per Kubernetes cluster, node, and GPU. Use the dropdowns to filter and the time range picker to set the window.",

  "templating": {
    "list": [
      {
        "name": "cluster",
        "type": "query",
        "label": "Cluster",
        "description": "Kubernetes cluster",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(gpu_inference_generated_tokens_total, cluster)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {}
      },
      {
        "name": "node",
        "type": "query",
        "label": "Node",
        "description": "GPU node",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(gpu_inference_generated_tokens_total{cluster=~\"$cluster\"}, node)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {}
      },
      {
        "name": "gpu",
        "type": "query",
        "label": "GPU",
        "description": "GPU index and model",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(gpu_utilization_percent{cluster=~\"$cluster\", node=~\"$node\"}, gpu_id)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {}
      }
    ]
  },

  "panels": [

    {
      "id": 1,
      "title": "Total Generated Tokens — Selected Period",
      "description": "Total tokens generated across all selected nodes/GPUs in the dashboard time range",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "graphMode": "area",
        "colorMode": "background",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(increase(gpu_inference_generated_tokens_total{cluster=~\"$cluster\", node=~\"$node\"}[$__range]))",
          "legendFormat": "Generated"
        }
      ]
    },

    {
      "id": 2,
      "title": "Total Prompt Tokens — Selected Period",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "graphMode": "area",
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(increase(gpu_inference_prompt_tokens_total{cluster=~\"$cluster\", node=~\"$node\"}[$__range]))",
          "legendFormat": "Prompt"
        }
      ]
    },

    {
      "id": 3,
      "title": "Current Throughput (tokens/s)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 100 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "area",
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(gpu_inference_tokens_per_second{cluster=~\"$cluster\", node=~\"$node\"})",
          "legendFormat": "tok/s"
        }
      ]
    },

    {
      "id": 4,
      "title": "Active Models",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "count(gpu_process_running{cluster=~\"$cluster\", node=~\"$node\"} == 1)",
          "legendFormat": "Models"
        }
      ]
    },

    {
      "id": 10,
      "title": "Token Consumption — Node × GPU Breakdown",
      "description": "Generated tokens per node and GPU for fixed time windows. Use the dashboard time range selector for the trend chart below.",
      "type": "table",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 10 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "1h" },
            "properties": [
              { "id": "custom.width", "value": 120 },
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.displayMode", "value": "color-background-solid" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "transparent", "value": null },
                { "color": "blue", "value": 1 }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "6h" },
            "properties": [
              { "id": "custom.width", "value": 120 },
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.displayMode", "value": "color-background-solid" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "transparent", "value": null },
                { "color": "blue", "value": 1 }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "12h" },
            "properties": [
              { "id": "custom.width", "value": 120 },
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.displayMode", "value": "color-background-solid" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "transparent", "value": null },
                { "color": "blue", "value": 1 }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "24h" },
            "properties": [
              { "id": "custom.width", "value": 120 },
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.displayMode", "value": "color-background-solid" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "transparent", "value": null },
                { "color": "blue", "value": 1 }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "node" },
            "properties": [{ "id": "custom.width", "value": 180 }]
          },
          {
            "matcher": { "id": "byName", "options": "gpu_id" },
            "properties": [{ "id": "custom.width", "value": 80 }]
          },
          {
            "matcher": { "id": "byName", "options": "gpu_name" },
            "properties": [{ "id": "custom.width", "value": 200 }]
          },
          {
            "matcher": { "id": "byName", "options": "cluster" },
            "properties": [{ "id": "custom.width", "value": 150 }]
          }
        ]
      },
      "options": {
        "sortBy": [{ "displayName": "24h", "desc": true }],
        "footer": {
          "show": true,
          "reducer": ["sum"],
          "fields": ["1h", "6h", "12h", "24h"]
        }
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "node", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #1h": "1h",
              "Value #6h": "6h",
              "Value #12h": "12h",
              "Value #24h": "24h"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (cluster, node, gpu_id, gpu_name) (increase(gpu_inference_generated_tokens_total{cluster=~\"$cluster\", node=~\"$node\"}[1h]))",
          "legendFormat": "{{cluster}} / {{node}} / gpu{{gpu_id}} / {{gpu_name}}",
          "instant": true,
          "refId": "1h"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (cluster, node, gpu_id, gpu_name) (increase(gpu_inference_generated_tokens_total{cluster=~\"$cluster\", node=~\"$node\"}[6h]))",
          "legendFormat": "{{cluster}} / {{node}} / gpu{{gpu_id}} / {{gpu_name}}",
          "instant": true,
          "refId": "6h"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (cluster, node, gpu_id, gpu_name) (increase(gpu_inference_generated_tokens_total{cluster=~\"$cluster\", node=~\"$node\"}[12h]))",
          "legendFormat": "{{cluster}} / {{node}} / gpu{{gpu_id}} / {{gpu_name}}",
          "instant": true,
          "refId": "12h"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (cluster, node, gpu_id, gpu_name) (increase(gpu_inference_generated_tokens_total{cluster=~\"$cluster\", node=~\"$node\"}[24h]))",
          "legendFormat": "{{cluster}} / {{node}} / gpu{{gpu_id}} / {{gpu_name}}",
          "instant": true,
          "refId": "24h"
        }
      ]
    },

    {
      "id": 20,
      "title": "Token Generation Rate — Over Selected Time Range",
      "description": "How token throughput has changed during the selected time window. Each line is one node.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "sum"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (cluster, node) (rate(gpu_inference_generated_tokens_total{cluster=~\"$cluster\", node=~\"$node\"}[$__rate_interval]) * 60)",
          "legendFormat": "{{cluster}} / {{node}}"
        }
      ]
    },

    {
      "id": 21,
      "title": "Token Generation Rate — Per GPU",
      "description": "Same as above but split per individual GPU within each node.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": true
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (cluster, node, gpu_id, gpu_name) (rate(gpu_inference_generated_tokens_total{cluster=~\"$cluster\", node=~\"$node\", gpu_id=~\"$gpu\"}[$__rate_interval]) * 60)",
          "legendFormat": "{{cluster}} / {{node}} / gpu{{gpu_id}} ({{gpu_name}})"
        }
      ]
    },

    {
      "id": 30,
      "title": "Token Consumption — Per Model",
      "description": "Which models consumed the most tokens in the selected time range.",
      "type": "piechart",
      "gridPos": { "x": 0, "y": 32, "w": 10, "h": 9 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 }
      },
      "options": {
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (model) (increase(gpu_inference_generated_tokens_total{cluster=~\"$cluster\", node=~\"$node\"}[$__range]))",
          "legendFormat": "{{model}}"
        }
      ]
    },

    {
      "id": 31,
      "title": "Token Consumption — Per Node",
      "description": "Share of total tokens per node in the selected time range.",
      "type": "piechart",
      "gridPos": { "x": 10, "y": 32, "w": 7, "h": 9 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 }
      },
      "options": {
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (node) (increase(gpu_inference_generated_tokens_total{cluster=~\"$cluster\", node=~\"$node\"}[$__range]))",
          "legendFormat": "{{node}}"
        }
      ]
    },

    {
      "id": 32,
      "title": "Running Models",
      "description": "Currently active inference processes across selected nodes.",
      "type": "table",
      "gridPos": { "x": 17, "y": 32, "w": 7, "h": 9 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } }
      },
      "options": { "sortBy": [{ "displayName": "node", "desc": false }] },
      "transformations": [
        { "id": "labelsToFields", "options": { "mode": "columns" } },
        {
          "id": "filterFieldsByName",
          "options": { "include": { "names": ["cluster", "node", "gpu_id", "model", "runtime"] } }
        }
      ],
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "gpu_process_running{cluster=~\"$cluster\", node=~\"$node\"} == 1",
          "legendFormat": "",
          "instant": true
        }
      ]
    }

  ]
}
